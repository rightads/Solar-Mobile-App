# ==============================================================================
# Solar Rooftop Management API - Production Environment Configuration
# ==============================================================================
# NOTE: Copy this file to .env.prod on your Hostinger VPS server:
#   cp .env.prod.example .env.prod
# Fill in real secrets. NEVER commit .env.prod to version control!
# ==============================================================================

# Application
ENV=prod
DEBUG=False
APP_NAME="Solar Rooftop Management API"
APP_VERSION="0.1.0"

# Server
HOST=0.0.0.0
PORT=8000
# Allowed origins for CORS (Replace with your frontend domain(s) or keep * for mobile apps)
CORS_ORIGINS=["*"]

# PostgreSQL (Matches the 'postgres' service defined in docker-compose.prod.yml)
POSTGRES_USER=solar_prod_user
POSTGRES_PASSWORD=REPLACE_WITH_SECURE_PASSWORD_HERE
POSTGRES_DB=solar_prod_db
DATABASE_URL=postgresql+asyncpg://solar_prod_user:REPLACE_WITH_SECURE_PASSWORD_HERE@postgres:5432/solar_prod_db
DB_ECHO=False
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# MongoDB (MongoDB Atlas or self-hosted)
MONGODB_URI=

# Security & JWT (Generate a 64-char key using: openssl rand -hex 32)
JWT_SECRET=REPLACE_WITH_A_SECURE_RANDOM_SECRET_KEY_MIN_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=30

# OTP Settings
OTP_EXPIRE_SECONDS=300
OTP_LENGTH=6
DEV_MOCK_OTP=
EXPOSE_DEV_OTP=False

# Super Admin (Auto-created on database seed if not already present)
SUPER_ADMIN_NAME="System Admin"
SUPER_ADMIN_EMAIL=admin@yourdomain.com
SUPER_ADMIN_PHONE=9876543210
SUPER_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_SUPERADMIN_PASSWORD

# Email Delivery (Resend API or SMTP)
RESEND_API_KEY=
RESEND_FROM_EMAIL="SolarPro <noreply@yourdomain.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=True
SMTP_SSL=False
EMAILS_FROM_EMAIL=noreply@yourdomain.com
EMAILS_FROM_NAME="SolarPro"
EMAIL_VERIFICATION_EXPIRE_SECONDS=600

# Storage (S3 or MinIO)
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET_NAME=solar-uploads-prod
STORAGE_REGION=ap-south-1
STORAGE_USE_SSL=True

# Firebase Push Notifications
FCM_SERVER_KEY=

