# ==============================================================================
# SolarPro API — production environment (copy to .env.prod on the server only,
# chmod 600, never commit). Every value marked REQUIRED must be set.
# ==============================================================================

ENV=prod
DEBUG=false
APP_NAME=Solar Rooftop Management API

# Browser origins allowed to call the API (mobile/desktop apps are unaffected).
CORS_ORIGINS=["https://solarpro-app.in","https://www.solarpro-app.in"]

# REQUIRED — MongoDB Atlas connection (use a dedicated least-privilege DB user).
MONGODB_URI=
MONGODB_DB_NAME=solar_app_db

# REQUIRED — 64 random hex chars:  openssl rand -hex 32
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Abuse limits (defaults shown)
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_SECONDS=900
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_HOUR=5
OTP_MAX_VERIFY_FAILURES_PER_HOUR=10
OTP_EXPIRE_SECONDS=300
OTP_LENGTH=6

# REQUIRED on first start — Super Admin is created once; later changes are ignored.
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PHONE=
# 8+ chars with letters and numbers. Remove from the file after first start.
SUPER_ADMIN_PASSWORD=

# SMS gateway (at least one, or OTP sign-in cannot deliver codes)
TWO_FACTOR_API_KEY=
FAST2SMS_API_KEY=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Email delivery (Resend preferred, SMTP fallback)
RESEND_API_KEY=
RESEND_FROM_EMAIL=SolarPro <no-reply@solarpro-app.in>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
SMTP_SSL=false
EMAILS_FROM_EMAIL=
EMAILS_FROM_NAME=SolarPro Verification
EMAIL_VERIFICATION_EXPIRE_SECONDS=600

# Uploaded files are stored on the uploads_data volume
MAX_UPLOAD_MB=10

FCM_SERVER_KEY=
