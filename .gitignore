# Git ignore rules for Solar-Mobile-App root

# Large binary release packages (attach to GitHub releases instead)
releases/*.apk
releases/*.zip
website/assets/*.apk
website/assets/*.zip

# OS / Editor files
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

backend_prompts/

# Environment & Secret files (Never commit to Git)
.env
.env.*
*.env
!.env.example
!.env.prod.example

# Local-only artefacts (may contain secrets / large media)
SECURITY_AUDIT_REPORT.md
*.mp4
scratch/
Backend/uploads/
